def main():
    parser = argparse.ArgumentParser(description="🧹 FastCleaner - Sanitizador Profundo de Metadatos y Spam de Video")
    parser.add_argument("target", nargs="?", help="Ruta al archivo de video o carpeta a sanitizar.")
    parser.add_argument("-o", "--output", help="Ruta de salida (por defecto: sobrescribe in-place en el mismo archivo).")
    parser.add_argument("-t", "--title", help="Título limpio personalizado para el contenedor.")
    parser.add_argument("--gui", action="store_true", help="Iniciar interfaz web interactiva.")
    parser.add_argument("-p", "--port", type=int, default=8099, help="Puerto para la interfaz web (por defecto: 8099).")
    parser.add_argument("--install-menu", "--install-context-menu", dest="install_menu", action="store_true", help="Instalar '🧹 Limpiar con FastCleaner' en el menú contextual (clic derecho) del explorador.")
    parser.add_argument("--remove-menu", "--remove-context-menu", dest="remove_menu", action="store_true", help="Desinstalar la opción de FastCleaner del menú contextual.")
    args = parser.parse_args()
    
    if args.install_menu:
        install_context_menu()
        sys.exit(0)
        
    if args.remove_menu:
        remove_context_menu()
        sys.exit(0)
        
    if args.gui or not args.target:
        run_web_gui(args.port)
        sys.exit(0)
        
    if os.path.isfile(args.target):
        sanitize_video_file(args.target, args.output, args.title)
    elif os.path.isdir(args.target):
        print(f"\n📂 Sanitizando lote de videos en carpeta: {args.target}...")
        sanitized_count = 0
        total_found = 0
        for root, _, files in os.walk(args.target):
            for f in sorted(files):
                ext = os.path.splitext(f)[1].lower()
                if ext in VIDEO_EXTS and not f.startswith('.'):
                    total_found += 1
                    res = sanitize_video_file(os.path.join(root, f))
                    if res.get("success"):
                        sanitized_count += 1
        print(f"\n🎉 ¡Proceso finalizado! Total de videos sanitizados: {sanitized_count} de {total_found} encontrados.\n")
    else:
        print(f"❌ La ruta no existe: {args.target}")
        sys.exit(1)

if __name__ == "__main__":
    main()

