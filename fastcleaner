SPAM_PATTERNS = [
    r'descargatelocorp', r'peliculasgoogledrive', r'cinecalidad', r'hackstore',
    r'compucalitv', r'yts\.', r'yify', r'rarbg', r'1337x', r'gnula',
    r'sololatino', r'pelisplus', r'grantorrent', r'divx', r'identi',
    r'subdivx', r'opensubtitles', r'www\.[a-z0-9\-\.]+\.[a-z]{2,}',
    r'https?://[^\s]+', r'\b[a-z0-9\-]+\.(com|org|net|info|top|xyz|lat|tv|ru|me|cc|to|is|cx|vip)\b'
]

VIDEO_EXTS = {'.mkv', '.mp4', '.m4v', '.mov', '.webm', '.avi', '.ts'}

def is_spam_string(text):
    if not text: return False
    t = str(text).strip().lower()
    return any(re.search(p, t) for p in SPAM_PATTERNS)

def probe_video(fpath):
    cmd = ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", "-show_streams", fpath]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        return None
    try:
        return json.loads(res.stdout)
    except Exception:
        return None

def clean_srt_cues(raw_srt):
    blocks = raw_srt.strip().replace('\r\n', '\n').split('\n\n')
    cleaned_blocks = []
    cue_counter = 1
    removed_cues = 0
    
    for b in blocks:
        lines = b.strip().split('\n')
        if len(lines) < 2: continue
        time_idx = -1
        for i, l in enumerate(lines):
            if '-->' in l:
                time_idx = i
                break
        if time_idx == -1: continue
        
        time_line = lines[time_idx]
        text_lines = lines[time_idx+1:]
        text_content = ' '.join(text_lines).strip()
        
        if is_spam_string(text_content):
            removed_cues += 1
            continue
            
        cleaned_blocks.append(f"{cue_counter}\n{time_line}\n" + "\n".join(text_lines))
        cue_counter += 1
        
    return "\n\n".join(cleaned_blocks) + "\n", removed_cues

def sanitize_video_file(file_path, output_path=None, custom_title=None, verbose=True):
    abs_in = os.path.abspath(file_path)
    if not os.path.exists(abs_in):
        if verbose: print(f"❌ Error: El archivo no existe: {file_path}")
        return {"success": False, "error": "Archivo no encontrado"}
        
    ext = os.path.splitext(abs_in)[1].lower()
    if ext not in VIDEO_EXTS:
        return {"success": False, "error": "Extensión no soportada"}
        
    if verbose: print(f"\n🔍 [FastCleaner] Analizando: {os.path.basename(abs_in)}...")
    meta = probe_video(abs_in)
    if not meta:
        return {"success": False, "error": "Fallo al inspeccionar con ffprobe"}
        
    streams = meta.get("streams", [])
    fmt = meta.get("format", {})
    fmt_tags = fmt.get("tags", {})
    
    fmt_title = fmt_tags.get("title", "")
    has_fmt_spam = is_spam_string(fmt_title)
    
    clean_title = custom_title or (re.sub(r'\[.*?\]|\(.*?\)', '', os.path.splitext(os.path.basename(abs_in))[0]).strip() if has_fmt_spam else fmt_title)
    
    v_streams = [s for s in streams if s.get("codec_type") == "video"]
    a_streams = [s for s in streams if s.get("codec_type") == "audio"]
    s_streams = [s for s in streams if s.get("codec_type") == "subtitle"]
    
    cleaned_items = {
        "global_title_cleaned": has_fmt_spam,
        "audio_tracks_cleaned": 0,
        "sub_tracks_discarded": 0,
        "sub_cues_purged": 0
    }
    
    # Procesar subtítulos
    valid_sub_files = []
    tmp_sub_paths = []
    
    for s_idx, s in enumerate(s_streams):
        stream_orig_idx = s.get("index")
        s_tags = s.get("tags", {})
        s_title = s_tags.get("title", "")
        s_lang = s_tags.get("language", "spa")
        s_disp = s.get("disposition", {})
        
        # Extraer para sanitizar
        res_sub = subprocess.run(["ffmpeg", "-v", "quiet", "-i", abs_in, "-map", f"0:{stream_orig_idx}", "-f", "srt", "-"], capture_output=True, text=True)
        raw_srt = res_sub.stdout
        
        if not raw_srt.strip():
            continue
            
        clean_srt, n_removed = clean_srt_cues(raw_srt)
        cleaned_items["sub_cues_purged"] += n_removed
        blocks_count = len(clean_srt.strip().split('\n\n')) if clean_srt.strip() else 0
        
        if blocks_count == 0:
            cleaned_items["sub_tracks_discarded"] += 1
            if verbose: print(f"   🗑️ Pista de subtítulo #{stream_orig_idx} descartada (solo contenía publicidad)")
            continue
            
        tmp_srt_file = f"/tmp/fastcleaner_{os.getpid()}_{s_idx}.srt"
        with open(tmp_srt_file, "w", encoding="utf-8") as f_sub:
            f_sub.write(clean_srt)
        tmp_sub_paths.append(tmp_srt_file)
        
        clean_s_title = "Español" if is_spam_string(s_title) or not s_title else s_title
        valid_sub_files.append({
            "tmp_path": tmp_srt_file,
            "lang": s_lang,
            "title": clean_s_title,
            "is_default": s_disp.get("default", 0) == 1 or s_disp.get("forced", 0) == 1,
            "is_forced": s_disp.get("forced", 0) == 1
        })
        
    out_target = output_path or abs_in
    is_mkv = ext == '.mkv'
    tmp_out = out_target + f".fastcleaner_{os.getpid()}.tmp{ext}"
    
    cmd = ["ffmpeg", "-y", "-v", "error", "-i", abs_in]
    for vsf in valid_sub_files:
        cmd.extend(["-i", vsf["tmp_path"]])
        
    # Mapear video
    for v_i in range(len(v_streams)):
        cmd.extend(["-map", f"0:v:{v_i}"])
        
    # Mapear audio
    for a_i in range(len(a_streams)):
        cmd.extend(["-map", f"0:a:{a_i}"])
        
    # Mapear subtítulos limpios
    for s_i in range(len(valid_sub_files)):
        cmd.extend(["-map", f"{s_i+1}:0"])
        
    # Códecs sin pérdida
    cmd.extend(["-c:v", "copy", "-c:a", "copy"])
    if is_mkv:
        cmd.extend(["-c:s", "subrip"])
    else:
        cmd.extend(["-c:s", "mov_text", "-movflags", "+faststart"])
        
    # Limpiar metadatos globales
    cmd.extend(["-map_metadata", "-1", "-map_metadata:s", "-1"])
    if clean_title:
        cmd.extend(["-metadata", f"title={clean_title}"])
        
    # Sanitizar pistas de audio
    for a_i, a_s in enumerate(a_streams):
        a_tags = a_s.get("tags", {})
        a_title = a_tags.get("title", "")
        a_lang = a_tags.get("language", "spa")
        if is_spam_string(a_title) or not a_title:
            cleaned_items["audio_tracks_cleaned"] += 1
            clean_a_title = "Español Latino" if a_lang in ('spa', 'es') else ("English" if a_lang in ('eng', 'en') else "Audio")
        else:
            clean_a_title = a_title
        cmd.extend([
            f"-metadata:s:a:{a_i}", f"language={a_lang}",
            f"-metadata:s:a:{a_i}", f"title={clean_a_title}"
        ])
        
    # Sanitizar subtítulos
    for s_i, vsf in enumerate(valid_sub_files):
        cmd.extend([
            f"-metadata:s:s:{s_i}", f"language={vsf['lang']}",
            f"-metadata:s:s:{s_i}", f"title={vsf['title']}"
        ])
        if vsf["is_default"] or vsf["is_forced"]:
            cmd.extend([f"-disposition:s:{s_i}", "default+forced" if vsf["is_forced"] else "default"])
            
    cmd.append(tmp_out)
    
    t_start = time.time()
    res_ff = subprocess.run(cmd)
    t_elapsed = time.time() - t_start
    
    # Limpiar temporales
    for tp in tmp_sub_paths:
        if os.path.exists(tp):
            try: os.remove(tp)
            except Exception: pass
            
    if res_ff.returncode != 0 or not os.path.exists(tmp_out):
        if os.path.exists(tmp_out):
            try: os.remove(tmp_out)
            except Exception: pass
        return {"success": False, "error": "Error durante el reensamblado FFmpeg"}
        
    os.replace(tmp_out, out_target)
    sz_mb = os.path.getsize(out_target) / (1024 * 1024)
    
    if verbose:
        print(f"✅ ¡Sanitizado con éxito en {t_elapsed:.1f}s! ({sz_mb:.1f} MB)")
        print(f"   🎯 Resumen: {cleaned_items['sub_cues_purged']} cues eliminados, {cleaned_items['sub_tracks_discarded']} pistas spam descartadas, {cleaned_items['audio_tracks_cleaned']} etiquetas limpiadas.\n")
        
    return {
        "success": True,
        "filename": os.path.basename(out_target),
        "path": out_target,
        "size_mb": round(sz_mb, 1),
        "time_sec": round(t_elapsed, 1),
        "cleaned": cleaned_items
    }

