class FastCleanerServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True

class FastCleanerHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in ('/', '/index.html'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_GUI.encode('utf-8'))
            return
            
        if parsed.path == '/api/pick_native':
            qs = urllib.parse.parse_qs(parsed.query)
            is_folder = qs.get('is_folder', ['0'])[0] == '1'
            chosen_path = pick_os_path(is_folder=is_folder)
            self.send_response(200)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            self.wfile.write(json.dumps({"path": chosen_path}).encode('utf-8'))
            return
            
        self.send_error(404)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        
        # Modo In-Place (0 espacio extra)
        if parsed.path == '/api/sanitize_local':
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            try:
                payload = json.loads(body)
            except Exception:
                payload = {}
                
            raw_path = payload.get('path', '')
            exp_path = os.path.abspath(os.path.expanduser(raw_path))
            
            if not os.path.exists(exp_path):
                self.send_response(400)
                self.send_header('Content-Type', 'application/json; charset=utf-8')
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": f"La ruta no existe: {exp_path}"}).encode('utf-8'))
                return
                
            if os.path.isfile(exp_path):
                res = sanitize_video_file(exp_path, verbose=False)
                res["is_dir"] = False
                self.send_response(200 if res.get('success') else 500)
                self.send_header('Content-Type', 'application/json; charset=utf-8')
                self.end_headers()
                self.wfile.write(json.dumps(res).encode('utf-8'))
                return
                
            elif os.path.isdir(exp_path):
                count = 0
                for root, _, files in os.walk(exp_path):
                    for f in sorted(files):
                        if os.path.splitext(f)[1].lower() in VIDEO_EXTS:
                            r = sanitize_video_file(os.path.join(root, f), verbose=False)
                            if r.get('success'): count += 1
                self.send_response(200)
                self.send_header('Content-Type', 'application/json; charset=utf-8')
                self.end_headers()
                self.wfile.write(json.dumps({"success": True, "is_dir": True, "path": exp_path, "processed_count": count}).encode('utf-8'))
                return

        # Modo Drag & Drop por HTTP (Guarda en Descargas)
        if parsed.path == '/api/sanitize':
            filename = urllib.parse.unquote(self.headers.get('X-Filename', 'video.mkv'))
            content_length = int(self.headers.get('Content-Length', 0))
            
            dest_dir = os.path.expanduser('~/Downloads/FastCleaner_Sanitized')
            os.makedirs(dest_dir, exist_ok=True)
            
            tmp_in = os.path.join(dest_dir, f"upload_{os.getpid()}_{filename}")
            final_out = os.path.join(dest_dir, filename)
            
            remaining = content_length
            with open(tmp_in, 'wb') as f_out:
                while remaining > 0:
                    chunk_sz = min(remaining, 64 * 1024)
                    chunk = self.rfile.read(chunk_sz)
                    if not chunk: break
                    f_out.write(chunk)
                    remaining -= len(chunk)
                    
            res = sanitize_video_file(tmp_in, final_out, verbose=False)
            if os.path.exists(tmp_in):
                try: os.remove(tmp_in)
                except Exception: pass
                
            self.send_response(200 if res.get('success') else 500)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            self.wfile.write(json.dumps(res).encode('utf-8'))
            return
            
        self.send_error(404)

