class FastCleanerServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True

class FastCleanerHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        if self.path in ('/', '/index.html'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_GUI.encode('utf-8'))
            return
        self.send_error(404)

    def do_POST(self):
        if self.path == '/api/sanitize':
            filename = urllib.parse.unquote(self.headers.get('X-Filename', 'video.mkv'))
            content_length = int(self.headers.get('Content-Length', 0))
            
            dest_dir = os.path.expanduser('~/Downloads/FastCleaner_Sanitized')
            os.makedirs(dest_dir, exist_ok=True)
            
            tmp_in = os.path.join(dest_dir, f"upload_{os.getpid()}_{filename}")
            final_out = os.path.join(dest_dir, filename)
            
            remaining = content_length
            with open(tmp_in, 'wb') as f_out:
                while remaining > 0:
                    chunk_sz = min(remaining, 64 * 1024)
                    chunk = self.rfile.read(chunk_sz)
                    if not chunk: break
                    f_out.write(chunk)
                    remaining -= len(chunk)
                    
            res = sanitize_video_file(tmp_in, final_out, verbose=False)
            if os.path.exists(tmp_in):
                try: os.remove(tmp_in)
                except Exception: pass
                
            self.send_response(200 if res.get('success') else 500)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            self.wfile.write(json.dumps(res).encode('utf-8'))
            return
            
        self.send_error(404)

