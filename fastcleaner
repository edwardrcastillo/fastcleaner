def main():
    parser = argparse.ArgumentParser(description="🧹 FastCleaner - Sanitizador Profundo de Metadatos y Spam de Video")
    parser.add_argument("target", nargs="?", help="Ruta al archivo de video o carpeta a sanitizar.")
    parser.add_argument("-o", "--output", help="Ruta de salida (por defecto: sobrescribe en el lugar).")
    parser.add_argument("-t", "--title", help="Título limpio personalizado para el contenedor.")
    parser.add_argument("--gui", action="store_true", help="Iniciar interfaz web interactiva estilo Drag & Drop.")
    parser.add_argument("-p", "--port", type=int, default=8099, help="Puerto para la interfaz web (por defecto: 8099).")
    args = parser.parse_args()
    
    if args.gui:
        run_web_gui(args.port)
        sys.exit(0)
        
    if not args.target:
        run_web_gui(args.port)
        sys.exit(0)
        
    if os.path.isfile(args.target):
        sanitize_video_file(args.target, args.output, args.title)
    elif os.path.isdir(args.target):
        print(f"\n📂 Sanitizando lote de videos en carpeta: {args.target}...")
        for root, _, files in os.walk(args.target):
            for f in sorted(files):
                ext = os.path.splitext(f)[1].lower()
                if ext in VIDEO_EXTS:
                    sanitize_video_file(os.path.join(root, f))
    else:
        print(f"❌ La ruta no existe: {args.target}")
